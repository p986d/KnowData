{
  "entities": [
    {
      "entity_name": "人员",
      "desc": "具有独立身份的个人，是社区管理和服务的基本对象。",
      "grain": "一个具体的人。",
      "attributes": [
        {
          "name": "人员标识",
          "semantics": "用于唯一标识一个人员的属性。"
        },
        {
          "name": "姓名",
          "semantics": "人员的姓名。"
        },
        {
          "name": "性别",
          "semantics": "人员的性别。"
        },
        {
          "name": "出生日期",
          "semantics": "人员的出生日期，用于计算年龄。"
        },
        {
          "name": "所属民族标识",
          "semantics": "人员所属民族的标识，指向一个民族实体。"
        }
      ],
      "primary_key": [
        "人员标识"
      ]
    },
    {
      "entity_name": "居委",
      "desc": "基层社区管理组织单元，用于界定人员居住和管理的范围。",
      "grain": "一个具体的居民委员会。",
      "attributes": [
        {
          "name": "居委标识",
          "semantics": "用于唯一标识一个居委的属性。"
        },
        {
          "name": "名称",
          "semantics": "居委的名称。"
        }
      ],
      "primary_key": [
        "居委标识"
      ]
    },
    {
      "entity_name": "民族",
      "desc": "用于标识和分类人员民族成分的参照对象。",
      "grain": "一个具体的民族类别。",
      "attributes": [
        {
          "name": "民族标识",
          "semantics": "用于唯一标识一个民族的属性。"
        },
        {
          "name": "名称",
          "semantics": "民族的名称。"
        }
      ],
      "primary_key": [
        "民族标识"
      ]
    }
  ],
  "relations": [
    {
      "relation_name": "居住于",
      "desc": "描述一个人员当前居住在某居委管辖范围内的事实关联。",
      "grain": "一个具体的人员与一个具体的居委之间的一条居住记录。",
      "participants": [
        {
          "role": "居民",
          "entity": "人员",
          "anchor_attribute": [
            "人员标识"
          ]
        },
        {
          "role": "居住地",
          "entity": "居委",
          "anchor_attribute": [
            "居委标识"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    }
  ],
  "conditions": [
    {
      "condition_name": "临青居委限定",
      "condition_type": "single_attribute",
      "targets": [
        "居委.名称"
      ],
      "description": "居委的名称必须为“临青”。"
    },
    {
      "condition_name": "百岁老人年龄下限",
      "condition_type": "single_attribute",
      "targets": [
        "人员.出生日期"
      ],
      "description": "人员的年龄（基于当前日期与出生日期计算）必须大于或等于100岁。"
    }
  ]
}