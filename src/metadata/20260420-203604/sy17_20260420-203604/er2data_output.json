{
  "人员": {
    "question": "找出所有独立的、可标识的个人（人员），并给出用于识别每个人员的主键及其性别。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_person_basic_info",
        "sy_community_link.ads_residence_relation",
        "sy_community_link.sys_dict_data"
      ],
      "columns": [
        "sy_community_link.ads_person_basic_info.person_id",
        "sy_community_link.ads_person_basic_info.gender",
        "sy_community_link.ads_person_basic_info.current_gender",
        "sy_community_link.ads_residence_relation.person_id",
        "sy_community_link.sys_dict_data.dict_type",
        "sy_community_link.sys_dict_data.dict_value",
        "sy_community_link.sys_dict_data.dict_label"
      ]
    },
    "result_sql": "SELECT \n    `person_id` AS `person_surrogate_id`,\n    `current_gender` AS `gender`\nFROM `sy_community_link`.`ads_person_basic_info`\nWHERE `delete_flag` = '0'",
    "nl2sql_result": true
  },
  "房屋": {
    "question": "找出所有“一处可供人员居住的房屋单元”实体，并给出用于识别每个房屋实例的主键，以及房屋所属的行政区域编码。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.ads_residence_relation",
        "sy_community_link.sys_dept"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.id",
        "sy_community_link.ads_address_hierarchy.dept_id",
        "sy_community_link.ads_address_hierarchy.name",
        "sy_community_link.ads_address_hierarchy.level",
        "sy_community_link.ads_house_basic_info.house_id",
        "sy_community_link.ads_house_basic_info.district",
        "sy_community_link.ads_house_basic_info.house_type",
        "sy_community_link.ads_house_basic_info.usage_type",
        "sy_community_link.ads_house_basic_info.province",
        "sy_community_link.ads_house_basic_info.city",
        "sy_community_link.ads_house_basic_info.street",
        "sy_community_link.ads_house_basic_info.neighborhood_committee",
        "sy_community_link.ads_house_basic_info.residential_area",
