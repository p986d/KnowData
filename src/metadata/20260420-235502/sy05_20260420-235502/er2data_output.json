{
  "行政区域": {
    "question": "找出名称为“大桥街道”的行政区域实体，并给出用于识别该实体的主键及其名称属性。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.sys_dept"
      ],
      "columns": [
        "sy_community_link.ads_house_basic_info.district",
        "sy_community_link.ads_house_basic_info.street",
        "sy_community_link.sys_dept.dept_id",
        "sy_community_link.sys_dept.dept_name"
      ]
    },
    "result_sql": "SELECT \n    `dept_id` AS `区域标识_代理`,\n    `dept_name` AS `名称`\nFROM `sy_community_link`.`sys_dept`\nWHERE `dept_name` = '大桥街道'",
    "nl2sql_result": true
  },
  "人员": {
    "question": "找出所有人员，并给出用于识别每个人员的主键。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_contact_info",
        "sy_community_link.ads_house_relation_info",
        "sy_community_link.ads_household_registration",
        "sy_community_link.ads_person_basic_info",
        "sy_community_link.ads_residence_relation"
      ],
      "columns": [
        "sy_community_link.ads_contact_info.person_id",
        "sy_community_link.ads_house_relation_info.owner_id",
        "sy_community_link.ads_house_relation_info.head_id",
        "sy_community_link.ads_house_relation_info.emergency_id",
        "sy_community_link.ads_household_registration.person_id",
        "sy_community_link.ads_person_basic_info.person_id",
        "sy_community_link.ads_residence_relation.person_id"
      ]
    },
    "result_sql": "SELECT DISTINCT\n    `person_id` AS `人员标识_代理`\nFROM `sy_community_link`.`ads_person_basic_info`\nWHERE `delete_flag` = 0",
    "nl2sql_result": true
  },
  "户籍关系": {
    "question": "找出户籍地为名称为“大桥街道”的行政区域的人员，并给出用于识别这些人员及其户籍地的主键。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.ads_house_relation_info",
        "sy_community_link.ads_household_registration",
        "sy_community_link.ads_person_basic_info",
        "sy_community_link.sys_dept"
      ],
      "columns": [
        "sy_community_link.ads_house_basic_info.house_id",
        "sy_community_link.ads_house_basic_info.street",
        "sy_community_link.ads_house_relation_info.house_id",
        "sy_community_link.ads_house_relation_info.owner_id",
        "sy_community_link.ads_house_relation_info.head_id",
        "sy_community_link.ads_household_registration.person_id",
        "sy_community_link.ads_household_registration.house_id",
        "sy_community_link.ads_household_registration.household_address",
        "sy_community_link.ads_person_basic_info.person_id",
        "sy_community_link.sys_dept.dept_id",
        "sy_community_link.sys_dept.dept_name",
        "sy_community_link.sys_dept.parent_id",
        "sy_community_link.sys_dept.ancestors",
        "sy_community_link.sys_dept.status"
      ]
    },
    "result_sql": "SELECT DISTINCT\n    hhr.`person_id` AS `人员标识_代理`,\n    sd.`dept_id` AS `区域标识_代理`\nFROM `sy_community_link`.`sys_dept` sd\nINNER JOIN `sy_community_link`.`ads_house_basic_info` hi \n    ON hi.`street` = sd.`dept_id` \n    AND hi.`delete_flag` = 0\nINNER JOIN `sy_community_link`.`ads_household_registration` hhr \n    ON hhr.`house_id` = hi.`house_id` \n    AND hhr.`delete_flag` = 0\nINNER JOIN `sy_community_link`.`ads_person_basic_info` p \n    ON p.`person_id` = hhr.`person_id` \n    AND p.`delete_flag` = 0\nWHERE sd.`dept_name` = '大桥街道'\n    AND sd.`delete_flag` = 0",
    "nl2sql_result": true
  }
}