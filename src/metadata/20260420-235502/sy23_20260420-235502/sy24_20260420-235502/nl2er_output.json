{
  "entities": [
    {
      "entity_name": "居委",
      "desc": "基层社区管理单位，是人员居住信息的归属范围。",
      "grain": "一个具体的居委实例，例如‘临青居委’。",
      "attributes": [
        {
          "name": "居委_标识",
          "semantics": "用于唯一标识一个居委的代码或ID。"
        },
        {
          "name": "居委_名称",
          "semantics": "居委的名称，例如‘临青’。"
        }
      ],
      "primary_key": [
        "居委_标识"
      ]
    },
    {
      "entity_name": "人员",
      "desc": "居住于某个居委管辖范围内的个人。",
      "grain": "一个具体的人。",
      "attributes": [
        {
          "name": "人员_标识",
          "semantics": "用于唯一标识一个人员的代码或ID。"
        },
        {
          "name": "人员_姓名",
          "semantics": "人员的姓名。"
        },
        {
          "name": "人员_性别",
          "semantics": "人员的性别。"
        },
        {
          "name": "人员_出生日期",
          "semantics": "人员的出生日期，用于计算年龄和精确排序。"
        },
        {
          "name": "人员_民族",
          "semantics": "人员所属的民族。"
        }
      ],
      "primary_key": [
        "人员_标识"
      ]
    }
  ],
  "relations": [
    {
      "relation_name": "居住于",
      "desc": "描述一个人员当前居住在某一个居委的管辖范围内。",
      "grain": "一个具体的人员与一个具体的居委之间存在的居住关联实例。",
      "participants": [
        {
          "role": "居住地",
          "entity": "居委",
          "anchor_attribute": [
            "居委_标识"
          ]
        },
        {
          "role": "居住者",
          "entity": "人员",
          "anchor_attribute": [
            "人员_标识"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    }
  ],
  "conditions": [
    {
      "condition_name": "目标居委限定",
      "condition_type": "single_attribute",
      "targets": [
        "居委.居委_名称"
      ],
      "description": "居委的名称必须为‘临青居委’。"
    }
  ]
}