  "属于": {
    "question": "找出属于“谢路路1弄”这一地址范围的房屋，并给出用于识别这些房屋及其所属地址范围的相关标识属性。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.ads_household_registration"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.id",
        "sy_community_link.ads_address_hierarchy.name",
        "sy_community_link.ads_address_hierarchy.level",
        "sy_community_link.ads_address_hierarchy.parent_id",
        "sy_community_link.ads_address_hierarchy.ancestors",
        "sy_community_link.ads_house_basic_info.house_id",
        "sy_community_link.ads_house_basic_info.road",
        "sy_community_link.ads_house_basic_info.nong",
        "sy_community_link.ads_house_basic_info.house_number",
        "sy_community_link.ads_house_basic_info.room_number",
        "sy_community_link.ads_house_basic_info.detailed_address",
        "sy_community_link.ads_house_basic_info.current_detailed_address",
        "sy_community_link.ads_household_registration.house_id",
        "sy_community_link.ads_household_registration.household_address"
      ]
    },
    "result_sql": "SELECT \n    hbi.`house_id` AS `房屋标识`,\n    ah.`id` AS `地址范围标识`,\n    ah.`name` AS `地址范围名称`\nFROM `sy_community_link`.`ads_address_hierarchy` ah\nJOIN `sy_community_link`.`ads_house_basic_info` hbi\n    ON hbi.`nong` = ah.`id`\nWHERE ah.`name` LIKE '%1弄%'\n    AND ah.`level` = 5\n    AND ah.`delete_flag` = 0\n    AND hbi.`delete_flag` = 0\nLIMIT 10",
    "nl2sql_result": true
  }
