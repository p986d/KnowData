  "居住于": {
    "question": "找出所有状态为‘常住’的‘居住于’关系，并给出对应的居住者（人员标识）、居住地（地理位置标识）以及居住状态。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.ads_person_basic_info",
        "sy_community_link.ads_residence_relation",
        "sy_community_link.sys_dept"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.id",
        "sy_community_link.ads_house_basic_info.house_id",
        "sy_community_link.ads_house_basic_info.dept_id",
        "sy_community_link.ads_person_basic_info.person_id",
