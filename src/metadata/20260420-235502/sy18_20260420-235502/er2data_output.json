  "位于": {
    "question": "找出所有位于名称为“谢路”的道路上的地理位置，并给出用于识别这些地理位置实例的“地理位置标识”以及其所属道路的“路名称”。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.sys_dept"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.id",
        "sy_community_link.ads_address_hierarchy.name",
        "sy_community_link.ads_address_hierarchy.level",
        "sy_community_link.ads_address_hierarchy.parent_id",
        "sy_community_link.ads_address_hierarchy.ancestors",
        "sy_community_link.ads_house_basic_info.road",
        "sy_community_link.ads_house_basic_info.dept_id",
        "sy_community_link.ads_house_basic_info.province",
        "sy_community_link.ads_house_basic_info.city",
        "sy_community_link.ads_house_basic_info.district",
        "sy_community_link.ads_house_basic_info.street",
        "sy_community_link.ads_house_basic_info.residential_area",
        "sy_community_link.sys_dept.dept_id",
        "sy_community_link.sys_dept.dept_name"
      ]
    },
    "result_sql": "SELECT \n    a.`id` AS `地理位置标识`,\n    r.`name` AS `路名称`\nFROM `sy_community_link`.`ads_address_hierarchy` AS a\nJOIN (\n    SELECT `id`, `name` \n    FROM `sy_community_link`.`ads_address_hierarchy`\n    WHERE `level` = 4 \n      AND `name` LIKE '%谢路%'\n      AND `delete_flag` = 0\n) AS r\nON (CONCAT(',', a.`ancestors`, ',') LIKE CONCAT('%,', r.`id`, ',%') \n    OR a.`id` = r.`id`)\nWHERE a.`delete_flag` = 0;",
    "nl2sql_result": true
  }
}