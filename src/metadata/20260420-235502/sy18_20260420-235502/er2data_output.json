{
  "人员": {
    "question": "找出所有人员，并给出用于识别每个人员的主键。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_household_registration",
        "sy_community_link.ads_person_basic_info",
        "sy_community_link.ads_residence_relation"
      ],
      "columns": [
        "sy_community_link.ads_household_registration.person_id",
        "sy_community_link.ads_person_basic_info.person_id",
        "sy_community_link.ads_residence_relation.person_id"
      ]
    },
    "result_sql": "SELECT \n    `person_id` AS `人员标识`\nFROM `sy_community_link`.`ads_person_basic_info`\nWHERE `delete_flag` = 0\nUNION\nSELECT \n    `person_id` AS `人员标识`\nFROM `sy_community_link`.`ads_residence_relation`\nWHERE `delete_flag` = 0\nUNION\nSELECT \n    `person_id` AS `人员标识`\nFROM `sy_community_link`.`ads_household_registration`\nWHERE `delete_flag` = 0",
    "nl2sql_result": true
  },
  "路": {
    "question": "找出名称为“谢路”的道路，并给出其路名称。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.name",
        "sy_community_link.ads_address_hierarchy.level",
        "sy_community_link.ads_house_basic_info.road"
      ]
    },
    "result_sql": "SELECT \n    `name` AS `路名称`\nFROM `sy_community_link`.`ads_address_hierarchy`\nWHERE `level` = 4\n    AND `name` LIKE '%谢路%'\n    AND `delete_flag` = 0;",
    "nl2sql_result": true
  },
