    "result_sql": "SELECT \n    `person_id` AS `人员标识`,\n    `dept_id` AS `地理位置标识`,\n    `live_status` AS `居住状态`\nFROM `sy_community_link`.`ads_residence_relation`\nWHERE `is_primary_residence` = 1\n  AND `delete_flag` = 0;",
