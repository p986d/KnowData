    "result_sql": "SELECT \n    `dept_id` AS `地理位置标识`,\n    `dept_name` AS `地理位置名称`\nFROM `sy_community_link`.`sys_dept`\nWHERE `delete_flag` = 0\n\nUNION ALL\n\nSELECT \n    `id` AS `地理位置标识`,\n    `name` AS `地理位置名称`\nFROM `sy_community_link`.`ads_address_hierarchy`\nWHERE `delete_flag` = 0",
