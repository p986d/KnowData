        "sy_community_link.ads_house_basic_info.neighborhood_committee",
        "sy_community_link.ads_house_basic_info.grid",
        "sy_community_link.ads_house_basic_info.residential_area",
        "sy_community_link.ads_house_basic_info.detailed_address",
        "sy_community_link.ads_house_basic_info.current_detailed_address",
