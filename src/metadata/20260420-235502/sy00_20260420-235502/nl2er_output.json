{
  "entities": [
    {
      "entity_name": "街道",
      "desc": "行政区划单位‘街道’，用于界定人口统计的地理范围。",
      "grain": "一个具体的街道实例，如‘大桥街道’。",
      "attributes": [
        {
          "name": "名称",
          "semantics": "街道的名称，用于匹配‘大桥街道’。"
        },
        {
          "name": "街道_surrogate_id",
          "semantics": "用于唯一标识一个街道实例的代理标识符。"
        }
      ],
      "primary_key": [
        "名称"
      ]
    },
    {
      "entity_name": "居委",
      "desc": "行政区划单位‘居民委员会’，是关联人员、房屋与街道的中间层级。",
      "grain": "一个具体的居民委员会实例。",
      "attributes": [
        {
          "name": "居委_surrogate_id",
          "semantics": "用于唯一标识一个居委实例的代理标识符。"
        }
      ],
      "primary_key": [
        "居委_surrogate_id"
      ]
    },
    {
      "entity_name": "人员",
      "desc": "个体的人，是人口统计的基本单元。",
      "grain": "一个具体的人。",
      "attributes": [
        {
          "name": "人员_surrogate_id",
          "semantics": "用于唯一标识一个人员实例的代理标识符。"
        }
      ],
      "primary_key": [
        "人员_surrogate_id"
      ]
    },
    {
      "entity_name": "房屋",
      "desc": "物理的居住场所（如住宅），是连接人员与居委的地理载体。",
      "grain": "一处具体的房屋。",
      "attributes": [
        {
          "name": "房屋_surrogate_id",
          "semantics": "用于唯一标识一处房屋实例的代理标识符。"
        }
      ],
      "primary_key": [
        "房屋_surrogate_id"
      ]
    }
  ],
  "relations": [
    {
      "relation_name": "居住于",
      "desc": "描述一个人员居住在一处房屋的事实。用于界定人员的常住状态。",
      "grain": "一个具体的人员与一处具体的房屋之间存在的居住关联实例。",
      "participants": [
        {
          "role": "居住者",
          "entity": "人员",
          "anchor_attribute": [
            "人员_surrogate_id"
          ]
        },
        {
          "role": "住所",
          "entity": "房屋",
          "anchor_attribute": [
            "房屋_surrogate_id"
          ]
        }
      ],
      "link_condition": "",
      "attributes": [
        {
          "name": "是否有效常住",
          "semantics": "描述该居住关系是否构成‘常住人口’的判断依据。具体判断逻辑（如时间范围、状态）未定。"
        }
      ]
    },
    {
      "relation_name": "属于（居委-街道）",
      "desc": "描述一个居委在行政层级上隶属于一个街道的关系。",
      "grain": "一个具体的居委与一个具体的街道之间的行政隶属关系实例。",
      "participants": [
        {
          "role": "下级单位",
          "entity": "居委",
          "anchor_attribute": [
            "居委_surrogate_id"
          ]
        },
        {
          "role": "上级单位",
          "entity": "街道",
          "anchor_attribute": [
            "名称"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    },
    {
      "relation_name": "坐落于",
      "desc": "描述一处房屋位于某个居委的管辖地理范围内。",
      "grain": "一处具体的房屋与一个具体的居委之间的地理位置关系实例。",
      "participants": [
        {
          "role": "坐落物",
          "entity": "房屋",
          "anchor_attribute": [
            "房屋_surrogate_id"
          ]
        },
        {
          "role": "管辖单位",
          "entity": "居委",
          "anchor_attribute": [
            "居委_surrogate_id"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    }
  ],
  "conditions": [
    {
      "condition_name": "街道范围限定",
      "condition_type": "single_attribute",
      "targets": [
        "街道.名称"
      ],
      "description": "限定统计的街道范围为名称等于‘大桥街道’的街道。"
    },
    {
      "condition_name": "常住人口口径限定",
      "condition_type": "single_attribute",
      "targets": [
        "居住于.是否有效常住"
      ],
      "description": "限定统计的人口为居住关系状态为‘常住’的人员。"
    }
  ]
}