{
  "entities": [
    {
      "entity_name": "街道",
      "desc": "基层行政区域，具有稳定的名称和地理/管理范围。",
      "grain": "一个具体的街道实例，例如‘大桥街道’。",
      "attributes": [
        {
          "name": "名称",
          "semantics": "街道的名称，例如‘大桥街道’。"
        },
        {
          "name": "街道_surrogate_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "街道_surrogate_id"
      ]
    },
    {
      "entity_name": "居委",
      "desc": "社区管理的基本单元，隶属于某个街道，具有稳定的名称。",
      "grain": "一个具体的居委实例，例如‘周家牌居委’。",
      "attributes": [
        {
          "name": "名称",
          "semantics": "居委的名称，例如‘周家牌居委’。"
        },
        {
          "name": "居委_surrogate_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "居委_surrogate_id"
      ]
    },
    {
      "entity_name": "人员",
      "desc": "社区内的个体居民。",
      "grain": "一个具体的人。",
      "attributes": [
        {
          "name": "出生日期",
          "semantics": "人员的出生日期，用于计算年龄和判断是否为老人。"
        },
        {
          "name": "居住状态",
          "semantics": "描述人员居住状况的抽象属性，用于判断是否满足‘独居’条件。"
        },
        {
          "name": "人员_surrogate_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "人员_surrogate_id"
      ]
    }
  ],
  "relations": [
    {
      "relation_name": "隶属于",
      "desc": "描述居委与街道之间的行政层级从属关系。",
      "grain": "一个具体的‘某居委隶属于某街道’的事实实例。",
      "participants": [
        {
          "role": "下级单元",
          "entity": "居委",
          "anchor_attribute": [
            "居委_surrogate_id"
          ]
        },
        {
          "role": "上级单元",
          "entity": "街道",
          "anchor_attribute": [
            "街道_surrogate_id"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    },
    {
      "relation_name": "居住于",
      "desc": "描述人员与居委之间的当前居住地关联。",
      "grain": "一个具体的‘某人居住于某居委’的事实实例。",
      "participants": [
        {
          "role": "居住者",
          "entity": "人员",
          "anchor_attribute": [
            "人员_surrogate_id"
          ]
        },
        {
          "role": "居住地",
          "entity": "居委",
          "anchor_attribute": [
            "居委_surrogate_id"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    }
  ],
  "conditions": [
    {
      "condition_name": "限定目标街道",
      "condition_type": "single_attribute",
      "targets": [
        "街道.名称"
      ],
      "description": "问题仅针对‘大桥街道’进行查询。"
    },
    {
      "condition_name": "限定目标居委",
      "condition_type": "single_attribute",
      "targets": [
        "居委.名称"
      ],
      "description": "问题仅针对‘周家牌居委’、‘银河苑居委’、‘临青居委’这三个具体居委进行查询。"
    }
  ]
}