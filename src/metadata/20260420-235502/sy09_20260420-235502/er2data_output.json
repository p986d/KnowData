  "地址层级": {
    "question": "找出所有地址层级（即具有唯一标识的地址节点，如某条路、某个弄、某个门牌号），并给出每个地址层级的主键。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.id",
        "sy_community_link.ads_address_hierarchy.name",
        "sy_community_link.ads_address_hierarchy.level",
        "sy_community_link.ads_house_basic_info.road",
        "sy_community_link.ads_house_basic_info.nong",
        "sy_community_link.ads_house_basic_info.house_number",
        "sy_community_link.ads_house_basic_info.room_number"
      ]
    },
    "result_sql": "SELECT \n    `id` AS `地址层级标识_surrogate_id`\nFROM `sy_community_link`.`ads_address_hierarchy`\nWHERE `delete_flag` = 0",
