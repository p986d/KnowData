  "隶属于": {
    "question": "找出所有隶属于名称为“大桥街道”的上级街道的地址层级，并给出用于识别这些地址层级和街道的主键。",
    "schema_linking": {
      "tables": [
        "sy_community_link.ads_address_hierarchy",
        "sy_community_link.ads_house_basic_info",
        "sy_community_link.sys_dept"
      ],
      "columns": [
        "sy_community_link.ads_address_hierarchy.id",
        "sy_community_link.ads_address_hierarchy.dept_id",
        "sy_community_link.ads_address_hierarchy.name",
        "sy_community_link.ads_address_hierarchy.level",
        "sy_community_link.ads_address_hierarchy.ancestors",
        "sy_community_link.ads_house_basic_info.street",
        "sy_community_link.ads_house_basic_info.road",
        "sy_community_link.ads_house_basic_info.nong",
        "sy_community_link.ads_house_basic_info.house_number",
        "sy_community_link.ads_house_basic_info.room_number",
        "sy_community_link.ads_house_basic_info.district",
        "sy_community_link.sys_dept.dept_id",
        "sy_community_link.sys_dept.dept_name",
        "sy_community_link.sys_dept.parent_id",
        "sy_community_link.sys_dept.ancestors",
        "sy_community_link.sys_dept.status",
        "sy_community_link.sys_dept.delete_flag"
      ]
    },
    "result_sql": "SELECT \n    a.`id` AS `地址层级标识_surrogate_id`,\n    street.`dept_id` AS `街道标识_surrogate_id`\nFROM `sy_community_link`.`sys_dept` street\nJOIN `sy_community_link`.`sys_dept` committee \n    ON committee.`parent_id` = street.`dept_id` \n    AND committee.`delete_flag` = 0 \n    AND committee.`status` = '0'\nJOIN `sy_community_link`.`ads_address_hierarchy` a \n    ON a.`dept_id` = committee.`dept_id` \n    AND a.`delete_flag` = 0\nWHERE street.`dept_name` = '大桥街道' \n    AND street.`delete_flag` = 0 \n    AND street.`status` = '0'",
    "nl2sql_result": true
  }
}