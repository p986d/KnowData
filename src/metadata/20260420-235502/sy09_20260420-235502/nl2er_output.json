{
  "entities": [
    {
      "entity_name": "房子",
      "desc": "一套具体的房屋，是统计和筛选的核心对象。",
      "grain": "一套房子",
      "attributes": [
        {
          "name": "建造年份",
          "semantics": "房子的建造年份，用于判断是否在2000年之前建造。"
        },
        {
          "name": "房子标识_surrogate_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "房子标识_surrogate_id"
      ]
    },
    {
      "entity_name": "地址层级",
      "desc": "连接房屋与行政区域的地理或行政划分单元，例如路、弄、门牌号等。在问题中作为关联房子与街道的中间对象。",
      "grain": "一个具有唯一标识的地址节点（如某条路、某个弄、某个门牌号）",
      "attributes": [
        {
          "name": "地址层级标识_surrogate_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "地址层级标识_surrogate_id"
      ]
    },
    {
      "entity_name": "街道",
      "desc": "一个行政区域对象，特指名为“大桥街道”的街道。是问题中房屋筛选的地理范围依据。",
      "grain": "一个街道",
      "attributes": [
        {
          "name": "名称",
          "semantics": "街道的名称，例如“大桥街道”。"
        },
        {
          "name": "街道标识_surrogate_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "街道标识_surrogate_id"
      ]
    }
  ],
  "relations": [
    {
      "relation_name": "属于",
      "desc": "描述一套房子坐落于或归属于一个特定的地址层级（如某条路、某个弄）。",
      "grain": "一套房子与一个地址层级之间的归属关系实例",
      "participants": [
        {
          "role": "被归属的房屋",
          "entity": "房子",
          "anchor_attribute": [
            "房子标识_surrogate_id"
          ]
        },
        {
          "role": "归属的目标层级",
          "entity": "地址层级",
          "anchor_attribute": [
            "地址层级标识_surrogate_id"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    },
    {
      "relation_name": "隶属于",
      "desc": "描述一个地址层级在行政或地理层级上隶属于一个特定的街道。",
      "grain": "一个地址层级与一个街道之间的隶属关系实例",
      "participants": [
        {
          "role": "下级地址层级",
          "entity": "地址层级",
          "anchor_attribute": [
            "地址层级标识_surrogate_id"
          ]
        },
        {
          "role": "上级街道",
          "entity": "街道",
          "anchor_attribute": [
            "街道标识_surrogate_id"
          ]
        }
      ],
      "link_condition": "",
      "attributes": []
    }
  ],
  "conditions": [
    {
      "condition_name": "房子建造时间早于2000年",
      "condition_type": "single_attribute",
      "targets": [
        "房子.建造年份"
      ],
      "description": "筛选出建造年份在2000年之前的房子。"
    },
    {
      "condition_name": "街道名称为大桥街道",
      "condition_type": "single_attribute",
      "targets": [
        "街道.名称"
      ],
      "description": "筛选出名称为“大桥街道”的街道。"
    }
  ]
}