        },
        {
          "name": "街道_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "街道_id"
      ]
    },
    {
      "entity_name": "人员",
      "desc": "被统计的个体人员。",
      "grain": "一个具体的人。",
      "attributes": [
        {
          "name": "民族",
          "semantics": "人员所属的民族类别"
        },
        {
          "name": "人员_id",
          "semantics": ""
        }
      ],
      "primary_key": [
        "人员_id"
      ]
    }
  ],
  "relations": [
    {
      "relation_name": "归属于",
      "desc": "描述一个人员行政上或居住地归属于某个街道的关系。",
