          "anchor_attribute": [
            "人员_id"
          ]
        },
        {
          "role": "归属范围",
          "entity": "街道",
          "anchor_attribute": [
            "街道_id"
          ]
        }
      ],
      "link_condition": "人员通过其居住地或户籍地所在的居委，向上关联到对应的街道。",
      "attributes": []
    }
  ],
  "conditions": [
    {
      "condition_name": "目标街道限定",
      "condition_type": "single_attribute",
      "targets": [
        "街道.街道名称"
      ],
      "description": "街道的名称必须为‘大桥街道’。"
    },
    {
      "condition_name": "人员民族限定",
      "condition_type": "single_attribute",
      "targets": [
        "人员.民族"
      ],
      "description": "人员的民族必须属于少数民族类别。"
